{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/contact/layout,_N_T_/contact/page,_N_T_/contact"},"segmentPaths":["/_tree","/_full","/contact/__PAGE__","/contact","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1-tw417awgvza.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/046rkacd53sxw.js\"/><script src=\"/_next/static/chunks/1zp2o36e3749-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2us7qv_uq7h07.js\" async=\"\"></script><script src=\"/_next/static/chunks/2ejk_26znfoeu.js\" async=\"\"></script><script src=\"/_next/static/chunks/3nc6x0_y5iwnk.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1p52jldn8i60q.js\" async=\"\"></script><script src=\"/_next/static/chunks/0l8fzc8sdyuv9.js\" async=\"\"></script><script src=\"/_next/static/chunks/1ntn7efqc-iiw.js\" async=\"\"></script><script src=\"/_next/static/chunks/3-n7p8ioenarb.js\" async=\"\"></script><title>Pattachitra | Traditional Art of Odisha</title><meta name=\"description\" content=\"Explore the traditional Pattachitra art of Odisha, its history, paintings, artists, culture, and heritage.\"/><meta name=\"keywords\" content=\"Pattachitra,Pattachitra art,Odisha art,traditional art of Odisha,Pattachitra paintings,Indian traditional art\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"navbar\"><a class=\"logo\" href=\"/\">PATTACHITRA</a><ul class=\"nav-links\"><li><a class=\"\" href=\"/\">Home</a></li><li><a class=\"\" href=\"/about\">About</a></li><li><a class=\"\" href=\"/gallery\">Gallery</a></li><li><a class=\"active\" href=\"/contact\">Contact</a></li></ul><button class=\"hamburger \" aria-label=\"Toggle menu\" aria-expanded=\"false\"><span></span><span></span><span></span></button></nav><div class=\"mobile-menu \"><ul><li><a class=\"\" href=\"/\">Home</a></li><li><a class=\"\" href=\"/about\">About</a></li><li><a class=\"\" href=\"/gallery\">Gallery</a></li><li><a class=\"active\" href=\"/contact\">Contact</a></li></ul></div><main class=\"page\"><div class=\"inner\"><header class=\"header\"><span class=\"eyebrow\">Connect with the Artist</span><h1 class=\"heading\">Get in Touch</h1><div class=\"head-line\"><span></span> <span class=\"head-dot\">✦</span> <span></span></div></header><div class=\"grid\"><div class=\"leftCol\"><div class=\"studioCard\"><h2 class=\"cardTitle\">Studio Contact</h2><ul class=\"contactList\"><li class=\"contactItem\"><span class=\"iconBubble\" aria-hidden=\"true\">📍</span><div><h4 class=\"contactLabel\">Heritage Studio Location</h4><p class=\"contactValue\">Raghurajpur Crafts Village, Puri District, Odisha, India — 752012</p></div></li><li class=\"contactItem\"><span class=\"iconBubble\" aria-hidden=\"true\">✉</span><div><h4 class=\"contactLabel\">Email Address</h4><p class=\"contactValue\"><a href=\"mailto:pattachitraa@gmail.com\">pattachitraa@gmail.com</a></p></div></li><li class=\"contactItem\"><span class=\"iconBubble\" aria-hidden=\"true\">📞</span><div><h4 class=\"contactLabel\">Direct Line</h4><p class=\"contactValue\"><a href=\"tel:+916372633342\">+91 6372633342</a></p></div></li><li class=\"contactItem\"><span class=\"iconBubble\" aria-hidden=\"true\">🕐</span><div><h4 class=\"contactLabel\">Studio Hours</h4><p class=\"contactValue\">Sunday – Saturday<br/>9:00 AM – 6:00 PM IST</p></div></li></ul><a href=\"https://wa.me/916374781871?text=Vanakkam!%20I%20would%20like%20to%20inquire%20about%20your%20Pattachitra%20paintings.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"waBtn\"><span aria-hidden=\"true\">💬</span> Instant Order via WhatsApp</a></div><div class=\"workflowCard\"><h3 class=\"workflowTitle\">From Idea to Art</h3><p class=\"workflowIntro\">Every custom Pattachitra painting is treated with traditional rigour — handmade canvas structures and authentic mineral stone colour processes. Custom timelines take between 1 to 8 weeks.</p><div class=\"workflowSteps\"><div class=\"workflowLine\"></div><div class=\"workflowStep\"><span class=\"stepNumber\">1</span><p class=\"stepText\">Initialize discussion detailing your preferred narrative theme &amp; scale sizes via form or WhatsApp.</p></div><div class=\"workflowStep\"><span class=\"stepNumber\">2</span><p class=\"stepText\">Receive pricing metrics, raw materials assessment, and visual concept alignment.</p></div><div class=\"workflowStep\"><span class=\"stepNumber\">3</span><p class=\"stepText\">Secure packaging and global architectural shipping setup.</p></div></div></div></div><div class=\"rightCol\"><div class=\"formCard\"><div class=\"formHeader\"><h3 class=\"formTitle\">Discuss Your Artwork</h3><p class=\"formDesc\">Share your artwork requirements with us, and we’ll get back to you personally.</p></div><form class=\"form\" noValidate=\"\"><div class=\"fieldGrid\"><div class=\"fieldGroup\"><label for=\"name\" class=\"label\">Name *</label><input id=\"name\" type=\"text\" required=\"\" class=\"input\" autoComplete=\"name\" name=\"name\" value=\"\"/></div><div class=\"fieldGroup\"><label for=\"email\" class=\"label\">Email *</label><input id=\"email\" type=\"email\" required=\"\" class=\"input\" autoComplete=\"email\" name=\"email\" value=\"\"/></div></div><div class=\"fieldGrid\"><div class=\"fieldGroup\"><label for=\"phone\" class=\"label\">WhatsApp Number *</label><input id=\"phone\" type=\"tel\" required=\"\" inputMode=\"numeric\" maxLength=\"10\" class=\"input\" autoComplete=\"tel\" name=\"phone\" value=\"\"/></div><div class=\"fieldGroup\"><label for=\"subject\" class=\"label\">Category *</label><input id=\"subject\" type=\"text\" required=\"\" class=\"input\" name=\"subject\" value=\"\"/></div></div><div class=\"fieldGroup\"><label for=\"message\" class=\"label\">Description *</label><textarea id=\"message\" name=\"message\" rows=\"5\" required=\"\" class=\"input textarea\" placeholder=\"Describe dimensions, desired configurations, deities, or historical epics...\"></textarea></div><button type=\"submit\" class=\"submitBtn\">Send Enquiry</button></form></div></div></div></div></main><!--$--><!--/$--><footer class=\"footer\"><div class=\"footer-inner\"><h2>Pattachitra Art • Odisha</h2><p>Preserving the ancient art of storytelling through colours and brushstrokes.</p><p class=\"artwork-rights\">&quot;All artworks displayed on this website are original creations by the artist. Please respect the artist&#x27;s work by not reproducing or using these artworks without permission.&quot;</p><p class=\"copy\">© 2026 All rights reserved</p></div></footer><script src=\"/_next/static/chunks/046rkacd53sxw.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[162319,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw.js\\\"],\\\"default\\\"]\\n3:I[339756,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw.js\\\"],\\\"default\\\"]\\n4:I[837457,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw.js\\\"],\\\"default\\\"]\\n5:I[347257,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw.js\\\"],\\\"ClientPageRoot\\\"]\\n6:I[69139,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw.js\\\",\\\"/_next/static/chunks/3-n7p8ioenarb.js\\\"],\\\"default\\\"]\\n9:I[897367,[\\\"/_next/static/chunks/0l8fzc8sdyuv9.js\\\",\\\"/_next/static/chunks/1ntn7efqc-iiw